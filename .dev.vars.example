# Copia este archivo como .dev.vars para desarrollo local (no se sube a git).
# En producción: npx wrangler secret put TURNSTILE_SECRET

# Clave secreta de PRUEBA de Turnstile (siempre pasa). Para probar el rechazo usa:
# 2x0000000000000000000000000000000AA
# Clave pública de PRUEBA (sobrescribe la real de wrangler.jsonc en local).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET=1x0000000000000000000000000000000AA

# Panel /admin. En producción: npx wrangler secret put ADMIN_PASSWORD (y SESSION_SECRET)
ADMIN_PASSWORD=cambia-esta-clave
# Cadena aleatoria larga para firmar la sesión: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=cambia-este-secreto

# Segundo factor del panel (TOTP). Vacío = sin MFA (comportamiento actual).
# Genera un secreto: uv run python -c "import sys; sys.path.insert(0,'src'); import mfa; print(mfa.random_secret())"
TOTP_SECRET=

# Aviso a Angélica cuando entra una cita (ver src/notify.py). Vacío = sin aviso.
# WhatsApp vía CallMeBot (gratis, uso personal): activa en callmebot.com y pega
# aquí la apikey que te manda el bot. El destino es config.WHATSAPP salvo que
# pongas NOTIFY_PHONE. En producción: npx wrangler secret put CALLMEBOT_APIKEY
# CALLMEBOT_APIKEY=
# NOTIFY_PHONE=

# Email vía Resend (gratis, 3.000 correos/mes): crea la clave en resend.com.
# NOTIFY_EMAIL es quien recibe el aviso; RESEND_FROM se puede dejar tal cual
# mientras no verifiques tu dominio (luego cámbialo a tu dirección verificada).
# En producción: npx wrangler secret put RESEND_API_KEY
# RESEND_API_KEY=
# NOTIFY_EMAIL=
# RESEND_FROM=

# Orígenes adicionales permitidos para CORS (por ejemplo tu futuro dominio propio):
# ALLOWED_ORIGINS=https://tu-dominio.com

